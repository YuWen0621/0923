# =============================================================
# CWA Open Data API Configuration Template
# =============================================================

# 1. 中央氣象署 (CWA) Open Data API 授權碼 (向氣象署會員中心申請)
CWA_API_KEY=YOUR_CWA_API_KEY_HERE

# 2. 預設資料集代號 (F-D0047-091: 臺灣各縣市鄉鎮未來1週逐12小時天氣預報)
CWA_DATASET_ID=F-D0047-091

# 3. 資料新鮮度檢查間隔小時數 (預設: 6 小時，用於檢查資料過期狀態)
CWA_REFRESH_INTERVAL_HOURS=6
